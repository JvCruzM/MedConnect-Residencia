<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Invalid_Speaker_Assignment</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Medical_Event__r.Live__c = FALSE,
    Medical_Event__r.End_Date_Time__c &lt; NOW()
)</errorConditionFormula>
    <errorMessage>Este evento não aceita novos palestrantes, pois está inativo ou já foi encerrado.</errorMessage>
</ValidationRule>
