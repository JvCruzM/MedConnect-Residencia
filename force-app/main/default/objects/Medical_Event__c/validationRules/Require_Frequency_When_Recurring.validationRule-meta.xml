<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Frequency_When_Recurring</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Recurring__c = TRUE,
    ISBLANK(TEXT(Frequency__c))
)</errorConditionFormula>
    <errorMessage>Você deve preencher a frequência quando o evento for recorrente.</errorMessage>
</ValidationRule>
