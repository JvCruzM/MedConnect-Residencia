<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_End_Date_After_Start_Date</fullName>
    <active>true</active>
    <errorConditionFormula>End_Date_Time__c &lt;= Start_Date_Time__c</errorConditionFormula>
    <errorMessage>A data/hora de término deve ser maior que a data/hora de início.</errorMessage>
</ValidationRule>
